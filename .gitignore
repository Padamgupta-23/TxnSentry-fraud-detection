@'
# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated database
reports/*.db
reports/**/*.db

# Testing and tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db
desktop.ini
'@ | Set-Content -Encoding utf8 .gitignore